{
  "name": "consumer-profile-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Personal AI Consumer Intelligence Laboratory — local-only analysis of your own digital activity.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4175 --strictPort",
    "test:unit": "node tests/analysis.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:ext": "node tests/extension.test.mjs",
    "check:privacy": "node scripts/check-no-private-data.mjs",
    "deploy": "node scripts/check-no-private-data.mjs && node scripts/deploy.mjs"
  },
  "dependencies": {
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout-forceatlas2": "0.10.1",
    "lucide-react": "1.56.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sigma": "3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
