{
  "manifest_version": 3,
  "name": "Consumer Lab Connector",
  "version": "1.0.0",
  "description": "Lets YOUR Consumer Intelligence Laboratory read your Chrome history locally, only after you grant permission. No data leaves your computer.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "history"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Consumer Lab Connector",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://academiccat16.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "icons": {
    "128": "icon128.png"
  }
}