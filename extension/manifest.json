{
  "manifest_version": 3,
  "name": "Consumer Lab Connector",
  "short_name": "Consumer Lab",
  "version": "1.1.0",
  "description": "Connects your own Chrome history, with your approval, to the Consumer Lab dashboard for private, on-device analysis.",
  "key": "",
  "minimum_chrome_version": "116",
  "homepage_url": "https://academiccat16.github.io/consumer-profile-dashboard/",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "history"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Consumer Lab Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://academiccat16.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
